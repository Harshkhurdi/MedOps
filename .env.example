# Values below are local examples, never production credentials.
DATABASE_URL=postgresql://medops@localhost:5433/medops
DIRECT_URL=postgresql://medops@localhost:5433/medops
APP_URL=http://localhost:3000
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.local-storage
# Production: private Vercel Blob token (server only)
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
NEXT_TELEMETRY_DISABLED=1

# Optional; server-only. A key does not enable AI until the administrator opts in.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Default false. Only enable after accepting NVIDIA's logging terms for non-confidential text.
# This exception applies only to nvidia/nemotron-3-ultra-550b-a55b:free.
OPENROUTER_ALLOW_PROVIDER_LOGGING=false

# Optional explicit email. No automatic sending; credentials stay outside PostgreSQL.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
