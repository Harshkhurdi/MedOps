generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TenderStatus {
  DRAFT
  UNDER_REVIEW
  DOCUMENTS_IN_PROGRESS
  READY_FOR_SUBMISSION
  SUBMITTED
  WON
  LOST
  CANCELLED
}

enum OrderStatus {
  ORDER_RECEIVED
  MANUFACTURER_ORDER_PENDING
  MANUFACTURER_ORDER_PLACED
  PROCESSING
  READY_FOR_DISPATCH
  PARTIALLY_DELIVERED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum Compliance {
  COMPLIES
  DOES_NOT_COMPLY
  REQUIRES_REVIEW
}

enum InstallationStatus {
  PENDING
  PARTIAL
  INSTALLED
  COMMISSIONED
  ACCEPTED
}

enum WarrantyBasis {
  CONTRACT
  DELIVERY
  INSTALLATION
  COMMISSIONING
  ACCEPTANCE
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  name          String
  passwordHash  String
  role          Role              @default(EMPLOYEE)
  active        Boolean           @default(true)
  sessions      Session[]
  permissions   Permission[]
  notifications Notification[]
  auditLogs     AuditLog[]
  serviceVisits ServiceVisit[]
  followUps     PaymentFollowUp[]
  createdTasks  Task[]            @relation("CreatedTasks")
  assignedTasks Task[]            @relation("AssignedTasks")
  rfqs          Rfq[]
  aiRequests    AiRequest[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Permission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  read      Boolean  @default(false)
  write     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model LoginAttempt {
  id          String    @id @default(cuid())
  key         String    @unique
  count       Int       @default(0)
  lockedUntil DateTime?
  windowStart DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CompanyProfile {
  id               String   @id @default(cuid())
  legalName        String
  address          String
  gstin            String?
  pan              String?
  email            String?
  phone            String?
  signatory        String?
  designation      String?
  logoFileId       String?
  letterheadFileId String?
  declarations     String   @default("")
  additionalFields Json     @default("{}")
  reminderDays     Int      @default(30)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Customer {
  contacts                CustomerContact[]
  interactions            CustomerInteraction[]
  opportunities           SalesOpportunity[]
  costs                   OperationalCost[]
  competitorLinks         CompetitorCustomer[]
  historical              Boolean                 @default(false)
  originalDate            DateTime?               @db.Date
  recordSource            String                  @default("MANUAL")
  tickets                 ServiceTicket[]
  amcOpportunities        AmcOpportunity[]
  consumableOpportunities ConsumableOpportunity[]
  slaRules                SlaRule[]
  securities              Security[]
  id                      String                  @id @default(cuid())
  name                    String
  institutionType         String?
  address                 String?
  state                   String?
  email                   String?
  phone                   String?
  contactName             String?
  notes                   String?
  rfqs                    Rfq[]
  tenders                 Tender[]
  orders                  PurchaseOrder[]
  invoices                Invoice[]
  equipment               Equipment[]
  amcs                    AmcContract[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model Manufacturer {
  opportunities SalesOpportunity[]
  costs         OperationalCost[]
  historical    Boolean               @default(false)
  originalDate  DateTime?             @db.Date
  recordSource  String                @default("MANUAL")
  installed     Equipment[]
  tickets       ServiceTicket[]
  parts         SparePart[]
  consumables   Consumable[]
  slaRules      SlaRule[]
  id            String                @id @default(cuid())
  name          String                @unique
  email         String?
  phone         String?
  contactName   String?
  notes         String?
  contacts      ManufacturerContact[]
  rfqs          Rfq[]
  quoteSeries   QuoteSeries[]
  products      Product[]
  tenderItems   TenderItem[]
  orderItems    PurchaseOrderItem[]
  documents     CompanyDocument[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model Product {
  tenderItems    TenderItem[]
  orderItems     PurchaseOrderItem[]
  opportunities  SalesOpportunity[]
  costs          OperationalCost[]
  historical     Boolean                   @default(false)
  originalDate   DateTime?                 @db.Date
  recordSource   String                    @default("MANUAL")
  installed      Equipment[]
  consumables    ConsumableCompatibility[]
  id             String                    @id @default(cuid())
  name           String
  model          String
  category       String?
  manufacturerId String
  manufacturer   Manufacturer              @relation(fields: [manufacturerId], references: [id])
  rfqs           Rfq[]
  quoteSeries    QuoteSeries[]
  specifications String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([manufacturerId, model])
}

model CompanyDocument {
  id             String        @id @default(cuid())
  name           String
  category       String
  issueDate      DateTime?     @db.Date
  expiryDate     DateTime?     @db.Date
  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  notes          String?
  active         Boolean       @default(true)
  files          StoredFile[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([expiryDate])
}

model Tender {
  trackerImports ExternalTenderImport[]
  institutionName String?
  opportunities   SalesOpportunity[]
  costs           OperationalCost[]
  securities      Security[]
  checklist       BidChecklist[]
  id              String                 @id @default(cuid())
  number          String                 @unique
  gemUrl          String?
  customerId      String?
  customer        Customer?              @relation(fields: [customerId], references: [id])
  category        String?
  deadline        DateTime?
  emd             Decimal?               @db.Decimal(18, 2)
  estimatedValue  Decimal?               @db.Decimal(18, 2)
  warrantyTerms   String?
  deliveryTerms   String?
  notes           String?
  status          TenderStatus           @default(DRAFT)
  reviewedAt      DateTime?
  reviewedBy      String?
  bidNumber       String?
  title           String?
  state           String?
  source          String?
  sourceUrl       String?
  publicationDate DateTime?              @db.Date
  historical      Boolean                @default(false)
  originalDate    DateTime?              @db.Date
  recordSource    String                 @default("MANUAL")
  decisions       TenderDecision[]
  rfqs            Rfq[]
  quoteSeries     QuoteSeries[]
  comparisons     CommercialComparison[]
  results         TenderResult[]
  items           TenderItem[]
  requirements    TenderRequirement[]
  files           StoredFile[]
  history         TenderStatusHistory[]
  generated       GeneratedDocument[]
  orders          PurchaseOrder[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([deadline, status])
}

model TenderItem {
  category String?
  sourceItemId String?
  sourceUrl String?
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id])
  id             String        @id @default(cuid())
  tenderId       String
  tender         Tender        @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  equipment      String
  model          String?
  quantity       Int
  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model TenderRequirement {
  id            String       @id @default(cuid())
  tenderId      String
  tender        Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  requirement   String
  specification String       @default("")
  compliance    Compliance   @default(REQUIRES_REVIEW)
  evidenceNotes String?
  files         StoredFile[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model TenderStatusHistory {
  id         String        @id @default(cuid())
  tenderId   String
  tender     Tender        @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  fromStatus TenderStatus?
  toStatus   TenderStatus
  changedBy  String
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model DocumentTemplate {
  id        String              @id @default(cuid())
  name      String
  kind      String
  body      String
  approved  Boolean             @default(false)
  version   Int                 @default(1)
  generated GeneratedDocument[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model GeneratedDocument {
  id           String            @id @default(cuid())
  tenderId     String?
  tender       Tender?           @relation(fields: [tenderId], references: [id])
  templateId   String?
  template     DocumentTemplate? @relation(fields: [templateId], references: [id])
  sourceModule String
  sourceId     String
  format       String
  snapshot     Json
  fileId       String            @unique
  file         StoredFile        @relation(fields: [fileId], references: [id])
  reviewedAt   DateTime?
  reviewedBy   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model PurchaseOrder {
  costs            OperationalCost[]
  historical       Boolean             @default(false)
  originalDate     DateTime?           @db.Date
  recordSource     String              @default("MANUAL")
  securities       Security[]
  id               String              @id @default(cuid())
  number           String              @unique
  tenderId         String?
  tender           Tender?             @relation(fields: [tenderId], references: [id])
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id])
  poDate           DateTime            @db.Date
  deliveryDeadline DateTime?           @db.Date
  paymentTerms     String?
  notes            String?
  status           OrderStatus         @default(ORDER_RECEIVED)
  confirmed        Boolean             @default(false)
  total            Decimal             @db.Decimal(18, 2)
  items            PurchaseOrderItem[]
  deliveries       Delivery[]
  equipment        Equipment[]
  invoices         Invoice[]
  files            StoredFile[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([deliveryDeadline, status])
}

model PurchaseOrderItem {
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id])
  id             String         @id @default(cuid())
  orderId        String
  order          PurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  equipment      String
  model          String?
  manufacturerId String?
  manufacturer   Manufacturer?  @relation(fields: [manufacturerId], references: [id])
  quantity       Int
  unitPrice      Decimal        @db.Decimal(18, 2)
  taxRate        Decimal        @db.Decimal(5, 2)
  deliveryItems  DeliveryItem[]
  units          Equipment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Delivery {
  costs        OperationalCost[]
  id           String            @id @default(cuid())
  orderId      String
  order        PurchaseOrder     @relation(fields: [orderId], references: [id])
  dispatchDate DateTime?         @db.Date
  transporter  String?
  tracking     String?
  expectedDate DateTime?         @db.Date
  actualDate   DateTime?         @db.Date
  location     String
  confirmed    Boolean           @default(false)
  notes        String?
  items        DeliveryItem[]
  equipment    Equipment[]
  files        StoredFile[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([orderId])
}

model DeliveryItem {
  id          String            @id @default(cuid())
  deliveryId  String
  delivery    Delivery          @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   PurchaseOrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([deliveryId, orderItemId])
}

model Equipment {
  location                String?
  department              String?
  manufacturerId          String?
  manufacturer            Manufacturer?           @relation(fields: [manufacturerId], references: [id])
  productId               String?
  product                 Product?                @relation(fields: [productId], references: [id])
  productName             String?
  model                   String?
  notes                   String?
  historical              Boolean                 @default(false)
  originalDate            DateTime?               @db.Date
  recordSource            String                  @default("MANUAL")
  tickets                 ServiceTicket[]
  amcOpportunities        AmcOpportunity[]
  consumableOpportunities ConsumableOpportunity[]
  id                      String                  @id @default(cuid())
  serialNumber            String                  @unique
  orderId                 String?
  order                   PurchaseOrder?          @relation(fields: [orderId], references: [id])
  orderItemId             String?
  orderItem               PurchaseOrderItem?      @relation(fields: [orderItemId], references: [id])
  deliveryId              String?
  delivery                Delivery?               @relation(fields: [deliveryId], references: [id])
  customerId              String
  customer                Customer                @relation(fields: [customerId], references: [id])
  installation            Installation?
  warranties              Warranty[]
  amcs                    AmcEquipment[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([orderItemId])
}

model Installation {
  costs             OperationalCost[]
  historical        Boolean            @default(false)
  originalDate      DateTime?          @db.Date
  recordSource      String             @default("MANUAL")
  id                String             @id @default(cuid())
  equipmentId       String             @unique
  equipment         Equipment          @relation(fields: [equipmentId], references: [id])
  status            InstallationStatus @default(PENDING)
  installationDate  DateTime?          @db.Date
  commissioningDate DateTime?          @db.Date
  acceptanceDate    DateTime?          @db.Date
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Warranty {
  type           String            @default("STANDARD")
  historical     Boolean           @default(false)
  originalDate   DateTime?         @db.Date
  recordSource   String            @default("MANUAL")
  id             String            @id @default(cuid())
  equipmentId    String
  equipment      Equipment         @relation(fields: [equipmentId], references: [id])
  commencement   WarrantyBasis
  durationMonths Int
  startDate      DateTime          @db.Date
  endDate        DateTime          @db.Date
  terms          String
  notes          String?
  files          StoredFile[]
  history        WarrantyHistory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([endDate])
}

model WarrantyHistory {
  id         String   @id @default(cuid())
  warrantyId String
  warranty   Warranty @relation(fields: [warrantyId], references: [id])
  snapshot   Json
  changedBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AmcContract {
  historical             Boolean          @default(false)
  originalDate           DateTime?        @db.Date
  recordSource           String           @default("MANUAL")
  slaRules               SlaRule[]
  opportunities          AmcOpportunity[]
  id                     String           @id @default(cuid())
  number                 String           @unique
  customerId             String
  customer               Customer         @relation(fields: [customerId], references: [id])
  startDate              DateTime         @db.Date
  endDate                DateTime         @db.Date
  amount                 Decimal          @db.Decimal(18, 2)
  serviceFrequencyMonths Int
  nextServiceDate        DateTime?        @db.Date
  responsibleName        String?
  status                 String           @default("ACTIVE")
  notes                  String?
  renewedFromId          String?
  equipment              AmcEquipment[]
  visits                 ServiceVisit[]
  files                  StoredFile[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([endDate, nextServiceDate])
}

model AmcEquipment {
  id          String      @id @default(cuid())
  amcId       String
  amc         AmcContract @relation(fields: [amcId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment   @relation(fields: [equipmentId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([amcId, equipmentId])
}

model ServiceVisit {
  historical    Boolean      @default(false)
  originalDate  DateTime?    @db.Date
  recordSource  String       @default("MANUAL")
  id            String       @id @default(cuid())
  amcId         String
  amc           AmcContract  @relation(fields: [amcId], references: [id])
  employeeId    String?
  employee      User?        @relation(fields: [employeeId], references: [id])
  scheduledDate DateTime     @db.Date
  completedDate DateTime?    @db.Date
  status        String       @default("SCHEDULED")
  complaint     String?
  notes         String?
  files         StoredFile[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Invoice {
  adjustments     FinancialAdjustment[]
  historical      Boolean               @default(false)
  originalDate    DateTime?             @db.Date
  recordSource    String                @default("MANUAL")
  id              String                @id @default(cuid())
  number          String                @unique
  customerId      String
  customer        Customer              @relation(fields: [customerId], references: [id])
  orderId         String?
  order           PurchaseOrder?        @relation(fields: [orderId], references: [id])
  invoiceDate     DateTime              @db.Date
  amount          Decimal               @db.Decimal(18, 2)
  taxAmount       Decimal               @db.Decimal(18, 2)
  total           Decimal               @db.Decimal(18, 2)
  paymentTermDays Int
  dueDate         DateTime              @db.Date
  notes           String?
  payments        Payment[]
  followUps       PaymentFollowUp[]
  files           StoredFile[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([dueDate])
}

model Payment {
  adjustments  FinancialAdjustment[]
  historical   Boolean               @default(false)
  originalDate DateTime?             @db.Date
  recordSource String                @default("MANUAL")
  id           String                @id @default(cuid())
  invoiceId    String
  invoice      Invoice               @relation(fields: [invoiceId], references: [id])
  amount       Decimal               @db.Decimal(18, 2)
  paymentDate  DateTime              @db.Date
  reference    String
  method       String
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([invoiceId])
}

model PaymentFollowUp {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id])
  employeeId  String?
  employee    User?     @relation(fields: [employeeId], references: [id])
  contactDate DateTime  @db.Date
  nextDate    DateTime? @db.Date
  notes       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([nextDate])
  @@index([invoiceId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  module      String
  recordId    String
  title       String
  priority    String
  reminderAt  DateTime?
  completedAt DateTime?
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, key])
  @@index([userId, readAt])
  @@index([userId, completedAt, dismissedAt, reminderAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  recordId  String?
  details   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module, createdAt])
}

model StoredFile {
  ticketId          String?
  ticket            ServiceTicket?     @relation(fields: [ticketId], references: [id])
  ticketVisitId     String?
  ticketVisit       TicketVisit?       @relation(fields: [ticketVisitId], references: [id])
  securityId        String?
  security          Security?          @relation(fields: [securityId], references: [id])
  id                String             @id @default(cuid())
  name              String
  key               String             @unique
  mime              String
  size              Int
  sha256            String
  module            String
  recordId          String
  version           Int                @default(1)
  companyDocumentId String?
  companyDocument   CompanyDocument?   @relation(fields: [companyDocumentId], references: [id])
  tenderId          String?
  tender            Tender?            @relation(fields: [tenderId], references: [id])
  requirementId     String?
  requirement       TenderRequirement? @relation(fields: [requirementId], references: [id])
  orderId           String?
  order             PurchaseOrder?     @relation(fields: [orderId], references: [id])
  deliveryId        String?
  delivery          Delivery?          @relation(fields: [deliveryId], references: [id])
  warrantyId        String?
  warranty          Warranty?          @relation(fields: [warrantyId], references: [id])
  amcId             String?
  amc               AmcContract?       @relation(fields: [amcId], references: [id])
  invoiceId         String?
  invoice           Invoice?           @relation(fields: [invoiceId], references: [id])
  serviceVisitId    String?
  serviceVisit      ServiceVisit?      @relation(fields: [serviceVisitId], references: [id])
  rfqId             String?
  rfq               Rfq?               @relation(fields: [rfqId], references: [id])
  quotationId       String?
  quotation         QuotationRevision? @relation(fields: [quotationId], references: [id])
  generated         GeneratedDocument?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([module, recordId])
}

model Task {
  id           String    @id @default(cuid())
  title        String
  notes        String?
  status       String    @default("OPEN")
  priority     String    @default("NORMAL")
  dueDate      DateTime? @db.Date
  completedAt  DateTime?
  createdById  String
  creator      User      @relation("CreatedTasks", fields: [createdById], references: [id])
  assignedToId String?
  assignee     User?     @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([assignedToId, status, dueDate])
  @@index([createdById])
}

model AppSettings {
  id                String   @id @default("main")
  aiEnabled         Boolean  @default(false)
  aiModel           String   @default("")
  aiDailyLimit      Int      @default(10)
  aiMaxOutputTokens Int      @default(1200)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AiRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("PENDING")
  purpose         String
  promptHash      String
  inputCharacters Int
  outputTokens    Int?
  costUsd         Decimal? @db.Decimal(16, 8)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
}

model TenderDecision {
  id         String   @id @default(cuid())
  tenderId   String
  tender     Tender   @relation(fields: [tenderId], references: [id])
  decision   String   @default("PENDING_REVIEW")
  decisionBy String
  decisionAt DateTime @default(now())
  reason     String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenderId, decisionAt])
}

model ManufacturerContact {
  id               String       @id @default(cuid())
  manufacturerId   String
  manufacturer     Manufacturer @relation(fields: [manufacturerId], references: [id])
  name             String
  designation      String?
  department       String?
  email            String?
  phone            String?
  whatsapp         String?
  region           String?
  category         String?
  preferredChannel String       @default("EMAIL")
  active           Boolean      @default(true)
  notes            String?
  rfqs             Rfq[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([manufacturerId, active])
}

model Rfq {
  id                   String                 @id @default(cuid())
  number               String                 @unique
  tenderId             String?
  tender               Tender?                @relation(fields: [tenderId], references: [id])
  customerId           String?
  customer             Customer?              @relation(fields: [customerId], references: [id])
  manufacturerId       String
  manufacturer         Manufacturer           @relation(fields: [manufacturerId], references: [id])
  contactId            String?
  contact              ManufacturerContact?   @relation(fields: [contactId], references: [id])
  productId            String?
  product              Product?               @relation(fields: [productId], references: [id])
  productName          String
  model                String?
  quantity             Int
  accessories          String?
  warrantyRequirement  String?
  deliveryLocation     String?
  requiredDeliveryTime String?
  tenderDeadline       DateTime?
  quoteRequiredBy      DateTime?
  assignedToId         String?
  assignee             User?                  @relation(fields: [assignedToId], references: [id])
  status               String                 @default("DRAFT")
  sentAt               DateTime?
  receivedAt           DateTime?
  notes                String?
  historical           Boolean                @default(false)
  originalDate         DateTime?              @db.Date
  recordSource         String                 @default("MANUAL")
  followUps            RfqFollowUp[]
  quoteSeries          QuoteSeries[]
  comparisons          CommercialComparison[]
  files                StoredFile[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([status, quoteRequiredBy])
  @@index([assignedToId, status])
}

model RfqFollowUp {
  id          String    @id @default(cuid())
  rfqId       String
  rfq         Rfq       @relation(fields: [rfqId], references: [id])
  employeeId  String?
  contactDate DateTime
  nextDate    DateTime?
  notes       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([rfqId, nextDate])
}

model QuoteSeries {
  id             String              @id @default(cuid())
  number         String
  manufacturerId String
  manufacturer   Manufacturer        @relation(fields: [manufacturerId], references: [id])
  rfqId          String?
  rfq            Rfq?                @relation(fields: [rfqId], references: [id])
  tenderId       String?
  tender         Tender?             @relation(fields: [tenderId], references: [id])
  productId      String?
  product        Product?            @relation(fields: [productId], references: [id])
  revisions      QuotationRevision[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([manufacturerId, number])
  @@index([tenderId])
}

model QuotationRevision {
  id                     String                 @id @default(cuid())
  seriesId               String
  series                 QuoteSeries            @relation(fields: [seriesId], references: [id])
  revision               Int
  number                 String
  quotationDate          DateTime               @db.Date
  validityDate           DateTime?              @db.Date
  currency               String                 @default("INR")
  productName            String
  model                  String?
  quantity               Int
  unitPrice              Decimal                @db.Decimal(18, 2)
  baseTotal              Decimal                @db.Decimal(18, 2)
  taxAmount              Decimal                @db.Decimal(18, 2)
  accessories            String?
  accessoriesCost        Decimal                @db.Decimal(18, 2)
  freight                Decimal                @db.Decimal(18, 2)
  installation           Decimal                @db.Decimal(18, 2)
  warranty               String?
  warrantyCost           Decimal                @db.Decimal(18, 2)
  extendedWarrantyCost   Decimal                @db.Decimal(18, 2)
  otherCosts             Decimal                @db.Decimal(18, 2)
  discount               Decimal                @db.Decimal(18, 2)
  total                  Decimal                @db.Decimal(18, 2)
  finalManufacturerPrice Decimal?               @db.Decimal(18, 2)
  leadTimeDays           Int?
  paymentTerms           String?
  isFinal                Boolean                @default(false)
  notes                  String?
  historical             Boolean                @default(false)
  originalDate           DateTime?              @db.Date
  recordSource           String                 @default("MANUAL")
  comparisons            CommercialComparison[]
  files                  StoredFile[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([seriesId, revision])
  @@index([validityDate])
}

model CommercialComparison {
  id              String             @id @default(cuid())
  name            String
  tenderId        String?
  tender          Tender?            @relation(fields: [tenderId], references: [id])
  rfqId           String?
  rfq             Rfq?               @relation(fields: [rfqId], references: [id])
  quoteId         String?
  quote           QuotationRevision? @relation(fields: [quoteId], references: [id])
  currency        String             @default("INR")
  procurementCost Decimal            @db.Decimal(18, 2)
  additionalCosts Decimal            @db.Decimal(18, 2)
  sellingPrice    Decimal            @db.Decimal(18, 2)
  totalCost       Decimal            @db.Decimal(18, 2)
  contribution    Decimal            @db.Decimal(18, 2)
  marginPercent   Decimal?           @db.Decimal(12, 4)
  leadTimeDays    Int?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([tenderId, rfqId])
}

model TenderResult {
  competitorId   String?
  competitor     Competitor? @relation(fields: [competitorId], references: [id])
  id             String      @id @default(cuid())
  tenderId       String
  tender         Tender      @relation(fields: [tenderId], references: [id])
  outcome        String
  resultDate     DateTime    @db.Date
  winner         String?
  winningPrice   Decimal?    @db.Decimal(18, 2)
  competitorName String?
  reason         String?
  notes          String?
  recordedBy     String
  historical     Boolean     @default(false)
  originalDate   DateTime?   @db.Date
  recordSource   String      @default("MANUAL")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([tenderId, resultDate])
}

model Security {
  id                 String         @id @default(cuid())
  type               String
  tenderId           String?
  tender             Tender?        @relation(fields: [tenderId], references: [id])
  orderId            String?
  order              PurchaseOrder? @relation(fields: [orderId], references: [id])
  customerId         String
  customer           Customer       @relation(fields: [customerId], references: [id])
  bank               String?
  reference          String
  amount             Decimal        @db.Decimal(18, 2)
  issueDate          DateTime?      @db.Date
  validityDate       DateTime?      @db.Date
  claimExpiry        DateTime?      @db.Date
  expectedRefundDate DateTime?      @db.Date
  actualRefundDate   DateTime?      @db.Date
  assignedToId       String?
  status             String         @default("PLANNED")
  notes              String?
  historical         Boolean        @default(false)
  originalDate       DateTime?      @db.Date
  recordSource       String         @default("MANUAL")
  files              StoredFile[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, validityDate])
  @@index([customerId, expectedRefundDate])
  @@index([tenderId, orderId])
}

model BidChecklist {
  id           String   @id @default(cuid())
  tenderId     String
  tender       Tender   @relation(fields: [tenderId], references: [id])
  section      String
  title        String
  status       String   @default("PENDING")
  assignedToId String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenderId, section, title])
  @@index([tenderId, status])
}

model ApprovalPolicy {
  id           String   @id @default(cuid())
  workflow     String   @unique
  preventSelf  Boolean  @default(true)
  approverRole String   @default("ADMIN")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Approval {
  id              String          @id @default(cuid())
  title           String
  workflow        String
  relatedModule   String
  recordId        String
  relevantVersion DateTime
  status          String          @default("CREATED")
  createdById     String
  approverId      String
  submittedById   String?
  submittedAt     DateTime?
  decisionById    String?
  decisionAt      DateTime?
  comments        String?
  events          ApprovalEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([relatedModule, recordId, status])
  @@index([approverId, status])
}

model ApprovalEvent {
  id              String   @id @default(cuid())
  approvalId      String
  approval        Approval @relation(fields: [approvalId], references: [id])
  fromStatus      String?
  toStatus        String
  actorId         String
  comments        String?
  relevantVersion DateTime
  createdAt       DateTime @default(now())
}

model MailLog {
  id            String    @id @default(cuid())
  recipient     String
  subject       String
  relatedModule String
  recordId      String
  senderId      String
  status        String    @default("PENDING")
  providerId    String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([relatedModule, recordId])
}

model ServiceTicket {
  costs           OperationalCost[]
  id              String                 @id @default(cuid())
  number          String                 @unique
  customerId      String
  customer        Customer               @relation(fields: [customerId], references: [id])
  equipmentId     String?
  equipment       Equipment?             @relation(fields: [equipmentId], references: [id])
  manufacturerId  String?
  manufacturer    Manufacturer?          @relation(fields: [manufacturerId], references: [id])
  serialNumber    String?
  productName     String
  model           String?
  department      String?
  issue           String
  priority        String                 @default("NORMAL")
  reportedAt      DateTime
  contactName     String?
  contactPhone    String?
  assignedToId    String?
  assignedAt      DateTime?
  firstVisitAt    DateTime?
  scheduledVisit  DateTime?
  resolution      String?
  resolvedAt      DateTime?
  status          String                 @default("OPEN")
  slaRuleId       String?
  slaRule         SlaRule?               @relation(fields: [slaRuleId], references: [id])
  assignmentDueAt DateTime?
  firstVisitDueAt DateTime?
  resolutionDueAt DateTime?
  notes           String?
  historical      Boolean                @default(false)
  originalDate    DateTime?              @db.Date
  recordSource    String                 @default("MANUAL")
  visits          TicketVisit[]
  inventory       InventoryTransaction[]
  files           StoredFile[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([customerId, equipmentId])
  @@index([assignedToId, status, scheduledVisit])
  @@index([priority, status, resolutionDueAt])
}

model TicketVisit {
  id              String        @id @default(cuid())
  ticketId        String
  ticket          ServiceTicket @relation(fields: [ticketId], references: [id])
  engineerId      String
  scheduledAt     DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  status          String        @default("SCHEDULED")
  workDone        String?
  representative  String?
  acknowledgement String?
  nextVisit       DateTime?
  notes           String?
  files           StoredFile[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([engineerId, status, scheduledAt])
}

model SlaRule {
  id              String          @id @default(cuid())
  name            String
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  manufacturerId  String?
  manufacturer    Manufacturer?   @relation(fields: [manufacturerId], references: [id])
  amcId           String?
  amc             AmcContract?    @relation(fields: [amcId], references: [id])
  warrantyType    String?
  assignmentHours Int
  firstVisitHours Int
  resolutionHours Int
  active          Boolean         @default(true)
  notes           String?
  tickets         ServiceTicket[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([customerId, manufacturerId, active])
}

model AmcOpportunity {
  id             String       @id @default(cuid())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  equipmentId    String
  equipment      Equipment    @relation(fields: [equipmentId], references: [id])
  amcId          String?
  amc            AmcContract? @relation(fields: [amcId], references: [id])
  reason         String
  triggerDate    DateTime?    @db.Date
  status         String       @default("NEW")
  assignedToId   String?
  followUpDate   DateTime?
  estimatedValue Decimal?     @db.Decimal(18, 2)
  notes          String?
  generated      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([equipmentId, reason])
  @@index([status, followUpDate])
}

model Consumable {
  id             String                    @id @default(cuid())
  sku            String                    @unique
  name           String
  manufacturerId String?
  manufacturer   Manufacturer?             @relation(fields: [manufacturerId], references: [id])
  active         Boolean                   @default(true)
  notes          String?
  compatibility  ConsumableCompatibility[]
  opportunities  ConsumableOpportunity[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
}

model ConsumableCompatibility {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  consumableId String
  consumable   Consumable @relation(fields: [consumableId], references: [id])
  active       Boolean    @default(true)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, consumableId])
}

model ConsumableOpportunity {
  id           String     @id @default(cuid())
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id])
  equipmentId  String?
  equipment    Equipment? @relation(fields: [equipmentId], references: [id])
  consumableId String
  consumable   Consumable @relation(fields: [consumableId], references: [id])
  lastSale     DateTime?  @db.Date
  lastQuantity Int?
  nextFollowUp DateTime?
  assignedToId String?
  status       String     @default("NEW")
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([customerId, equipmentId, status])
  @@index([nextFollowUp])
}

model SparePart {
  id               String                 @id @default(cuid())
  sku              String                 @unique
  name             String
  manufacturerId   String?
  manufacturer     Manufacturer?          @relation(fields: [manufacturerId], references: [id])
  compatibleModels String?
  onHand           Int                    @default(0)
  reserved         Int                    @default(0)
  reorderLevel     Int                    @default(0)
  unitCost         Decimal?               @db.Decimal(18, 2)
  location         String?
  supplier         String?
  active           Boolean                @default(true)
  notes            String?
  transactions     InventoryTransaction[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model InventoryTransaction {
  fromReserved    Boolean        @default(false)
  id              String         @id @default(cuid())
  partId          String
  part            SparePart      @relation(fields: [partId], references: [id])
  type            String
  quantity        Int
  ticketId        String?
  ticket          ServiceTicket? @relation(fields: [ticketId], references: [id])
  engineerId      String?
  transactionDate DateTime
  actorId         String
  onHandAfter     Int
  reservedAfter   Int
  notes           String?
  requestId       String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([partId, transactionDate])
  @@index([ticketId])
}

model CustomerContact {
  id               String                @id @default(cuid())
  customerId       String
  customer         Customer              @relation(fields: [customerId], references: [id])
  name             String
  designation      String?
  department       String?
  phone            String?
  email            String?
  preferredChannel String                @default("EMAIL")
  active           Boolean               @default(true)
  notes            String?
  interactions     CustomerInteraction[]
  historical       Boolean               @default(false)
  originalDate     DateTime?             @db.Date
  recordSource     String                @default("MANUAL")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([customerId, active])
}

model CustomerInteraction {
  id            String           @id @default(cuid())
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  contactId     String?
  contact       CustomerContact? @relation(fields: [contactId], references: [id])
  employeeId    String
  type          String
  occurredAt    DateTime
  nextFollowUp  DateTime?
  relatedModule String?
  recordId      String?
  notes         String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([customerId, occurredAt])
  @@index([employeeId, nextFollowUp])
}

model SalesOpportunity {
  id             String        @id @default(cuid())
  title          String
  type           String
  stage          String        @default("IDENTIFIED")
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id])
  tenderId       String?
  tender         Tender?       @relation(fields: [tenderId], references: [id])
  estimatedValue Decimal?      @db.Decimal(18, 2)
  probability    Int?
  expectedClose  DateTime?     @db.Date
  assignedToId   String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([customerId, stage])
  @@index([assignedToId, expectedClose])
}

model Competitor {
  id         String               @id @default(cuid())
  company    String               @unique
  brands     String?
  categories String?
  notes      String?
  results    TenderResult[]
  customers  CompetitorCustomer[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model CompetitorCustomer {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id])
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id])
  category     String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([customerId, competitorId])
}

model OperationalCost {
  id             String         @id @default(cuid())
  title          String
  category       String
  amount         Decimal        @db.Decimal(18, 2)
  incurredDate   DateTime       @db.Date
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  manufacturerId String?
  manufacturer   Manufacturer?  @relation(fields: [manufacturerId], references: [id])
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id])
  tenderId       String?
  tender         Tender?        @relation(fields: [tenderId], references: [id])
  orderId        String?
  order          PurchaseOrder? @relation(fields: [orderId], references: [id])
  deliveryId     String?
  delivery       Delivery?      @relation(fields: [deliveryId], references: [id])
  installationId String?
  installation   Installation?  @relation(fields: [installationId], references: [id])
  ticketId       String?
  ticket         ServiceTicket? @relation(fields: [ticketId], references: [id])
  employeeId     String?
  serviceCost    Boolean        @default(false)
  postSale       Boolean        @default(false)
  notes          String?
  historical     Boolean        @default(false)
  originalDate   DateTime?      @db.Date
  recordSource   String         @default("MANUAL")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([customerId, incurredDate])
  @@index([orderId, category])
  @@index([manufacturerId, productId])
}

model FinancialAdjustment {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  paymentId      String?
  payment        Payment? @relation(fields: [paymentId], references: [id])
  type           String
  amount         Decimal  @db.Decimal(18, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(18, 2)
  adjustmentDate DateTime @db.Date
  reference      String
  reason         String
  actorId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([invoiceId, reference])
  @@index([invoiceId, adjustmentDate])
}

model BulkImport {
  id         String    @id @default(cuid())
  module     String
  ownerId    String
  payload    Json
  preview    Json
  report     Json      @default("[]")
  status     String    @default("PREVIEW")
  runId      String?
  leaseUntil DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId, status, expiresAt])
}

// One-way discovery integration. Session/grant identifiers never reach record APIs.
model TenderTrackerGrant {
  id String @id @default(cuid())
  codeHash String @unique
  codeConsumed Boolean @default(false)
  tokenHash String? @unique
  sessionId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model ExternalTenderImport {
  id String @id @default(cuid())
  externalSource String @default("TENDER_TRACKER")
  externalTenderId String
  externalSourceUrl String
  tenderId String
  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Restrict)
  importedAt DateTime @default(now())
  sourceUpdatedAt DateTime?
  versions TenderSourceVersion[]
  @@unique([externalSource, externalTenderId])
  @@index([tenderId])
  @@index([externalSourceUrl])
}
model TenderSourceVersion {
  id String @id @default(cuid())
  importId String
  import ExternalTenderImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  fingerprint String
  snapshot Json
  discoveredAt DateTime
  sourceUpdatedAt DateTime?
  receivedAt DateTime @default(now())
  resolution String @default("PENDING_REVIEW")
  resolvedBy String?
  resolvedAt DateTime?
  @@unique([importId, fingerprint])
  @@index([importId, receivedAt])
}
model TenderTrackerHealth {
  id String @id @default("main")
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  failureReason String?
}
model TenderTrackerRate {
  key String @id
  window DateTime
  count Int @default(1)
}
