generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TenderStatus {
  DRAFT
  UNDER_REVIEW
  DOCUMENTS_IN_PROGRESS
  READY_FOR_SUBMISSION
  SUBMITTED
  WON
  LOST
  CANCELLED
}

enum OrderStatus {
  ORDER_RECEIVED
  MANUFACTURER_ORDER_PENDING
  MANUFACTURER_ORDER_PLACED
  PROCESSING
  READY_FOR_DISPATCH
  PARTIALLY_DELIVERED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum Compliance {
  COMPLIES
  DOES_NOT_COMPLY
  REQUIRES_REVIEW
}

enum InstallationStatus {
  PENDING
  PARTIAL
  INSTALLED
  COMMISSIONED
  ACCEPTED
}

enum WarrantyBasis {
  DELIVERY
  INSTALLATION
  COMMISSIONING
  ACCEPTANCE
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  name          String
  passwordHash  String
  role          Role              @default(EMPLOYEE)
  active        Boolean           @default(true)
  sessions      Session[]
  permissions   Permission[]
  notifications Notification[]
  auditLogs     AuditLog[]
  serviceVisits ServiceVisit[]
  followUps     PaymentFollowUp[]
  createdTasks  Task[]            @relation("CreatedTasks")
  assignedTasks Task[]            @relation("AssignedTasks")
  rfqs          Rfq[]
  aiRequests    AiRequest[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Permission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  read      Boolean  @default(false)
  write     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model LoginAttempt {
  id          String    @id @default(cuid())
  key         String    @unique
  count       Int       @default(0)
  lockedUntil DateTime?
  windowStart DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CompanyProfile {
  id               String   @id @default(cuid())
  legalName        String
  address          String
  gstin            String?
  pan              String?
  email            String?
  phone            String?
  signatory        String?
  designation      String?
  logoFileId       String?
  letterheadFileId String?
  declarations     String   @default("")
  additionalFields Json     @default("{}")
  reminderDays     Int      @default(30)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Customer {
  id              String          @id @default(cuid())
  name            String
  institutionType String?
  address         String?
  state           String?
  email           String?
  phone           String?
  contactName     String?
  notes           String?
  rfqs            Rfq[]
  tenders         Tender[]
  orders          PurchaseOrder[]
  invoices        Invoice[]
  equipment       Equipment[]
  amcs            AmcContract[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Manufacturer {
  id          String              @id @default(cuid())
  name        String              @unique
  email       String?
  phone       String?
  contactName String?
  notes       String?
  contacts    ManufacturerContact[]
  rfqs        Rfq[]
  quoteSeries QuoteSeries[]
  products    Product[]
  tenderItems TenderItem[]
  orderItems  PurchaseOrderItem[]
  documents   CompanyDocument[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Product {
  id             String       @id @default(cuid())
  name           String
  model          String
  category       String?
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  rfqs           Rfq[]
  quoteSeries    QuoteSeries[]
  specifications String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([manufacturerId, model])
}

model CompanyDocument {
  id             String        @id @default(cuid())
  name           String
  category       String
  issueDate      DateTime?     @db.Date
  expiryDate     DateTime?     @db.Date
  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  notes          String?
  active         Boolean       @default(true)
  files          StoredFile[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([expiryDate])
}

model Tender {
  id             String                @id @default(cuid())
  number         String                @unique
  gemUrl         String?
  customerId     String?
  customer       Customer?             @relation(fields: [customerId], references: [id])
  category       String?
  deadline       DateTime?
  emd            Decimal?              @db.Decimal(18, 2)
  estimatedValue Decimal?              @db.Decimal(18, 2)
  warrantyTerms  String?
  deliveryTerms  String?
  notes          String?
  status         TenderStatus          @default(DRAFT)
  reviewedAt     DateTime?
  reviewedBy     String?
  bidNumber      String?
  title          String?
  state          String?
  source         String?
  sourceUrl      String?
  publicationDate DateTime? @db.Date
  historical     Boolean @default(false)
  originalDate   DateTime? @db.Date
  recordSource   String @default("MANUAL")
  decisions      TenderDecision[]
  rfqs           Rfq[]
  quoteSeries    QuoteSeries[]
  comparisons    CommercialComparison[]
  results        TenderResult[]
  items          TenderItem[]
  requirements   TenderRequirement[]
  files          StoredFile[]
  history        TenderStatusHistory[]
  generated      GeneratedDocument[]
  orders         PurchaseOrder[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([deadline, status])
}

model TenderItem {
  id             String        @id @default(cuid())
  tenderId       String
  tender         Tender        @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  equipment      String
  model          String?
  quantity       Int
  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model TenderRequirement {
  id            String       @id @default(cuid())
  tenderId      String
  tender        Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  requirement   String
  specification String       @default("")
  compliance    Compliance   @default(REQUIRES_REVIEW)
  evidenceNotes String?
  files         StoredFile[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model TenderStatusHistory {
  id         String        @id @default(cuid())
  tenderId   String
  tender     Tender        @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  fromStatus TenderStatus?
  toStatus   TenderStatus
  changedBy  String
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model DocumentTemplate {
  id        String              @id @default(cuid())
  name      String
  kind      String
  body      String
  approved  Boolean             @default(false)
  version   Int                 @default(1)
  generated GeneratedDocument[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model GeneratedDocument {
  id           String            @id @default(cuid())
  tenderId     String?
  tender       Tender?           @relation(fields: [tenderId], references: [id])
  templateId   String?
  template     DocumentTemplate? @relation(fields: [templateId], references: [id])
  sourceModule String
  sourceId     String
  format       String
  snapshot     Json
  fileId       String            @unique
  file         StoredFile        @relation(fields: [fileId], references: [id])
  reviewedAt   DateTime?
  reviewedBy   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  number           String              @unique
  tenderId         String?
  tender           Tender?             @relation(fields: [tenderId], references: [id])
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id])
  poDate           DateTime            @db.Date
  deliveryDeadline DateTime?           @db.Date
  paymentTerms     String?
  notes            String?
  status           OrderStatus         @default(ORDER_RECEIVED)
  confirmed        Boolean             @default(false)
  total            Decimal             @db.Decimal(18, 2)
  items            PurchaseOrderItem[]
  deliveries       Delivery[]
  equipment        Equipment[]
  invoices         Invoice[]
  files            StoredFile[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([deliveryDeadline, status])
}

model PurchaseOrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          PurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  equipment      String
  model          String?
  manufacturerId String?
  manufacturer   Manufacturer?  @relation(fields: [manufacturerId], references: [id])
  quantity       Int
  unitPrice      Decimal        @db.Decimal(18, 2)
  taxRate        Decimal        @db.Decimal(5, 2)
  deliveryItems  DeliveryItem[]
  units          Equipment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Delivery {
  id           String         @id @default(cuid())
  orderId      String
  order        PurchaseOrder  @relation(fields: [orderId], references: [id])
  dispatchDate DateTime?      @db.Date
  transporter  String?
  tracking     String?
  expectedDate DateTime?      @db.Date
  actualDate   DateTime?      @db.Date
  location     String
  confirmed    Boolean        @default(false)
  notes        String?
  items        DeliveryItem[]
  equipment    Equipment[]
  files        StoredFile[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([orderId])
}

model DeliveryItem {
  id          String            @id @default(cuid())
  deliveryId  String
  delivery    Delivery          @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   PurchaseOrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([deliveryId, orderItemId])
}

model Equipment {
  id           String            @id @default(cuid())
  serialNumber String            @unique
  orderId      String
  order        PurchaseOrder     @relation(fields: [orderId], references: [id])
  orderItemId  String
  orderItem    PurchaseOrderItem @relation(fields: [orderItemId], references: [id])
  deliveryId   String
  delivery     Delivery          @relation(fields: [deliveryId], references: [id])
  customerId   String
  customer     Customer          @relation(fields: [customerId], references: [id])
  installation Installation?
  warranties   Warranty[]
  amcs         AmcEquipment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([orderItemId])
}

model Installation {
  id                String             @id @default(cuid())
  equipmentId       String             @unique
  equipment         Equipment          @relation(fields: [equipmentId], references: [id])
  status            InstallationStatus @default(PENDING)
  installationDate  DateTime?          @db.Date
  commissioningDate DateTime?          @db.Date
  acceptanceDate    DateTime?          @db.Date
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Warranty {
  id             String            @id @default(cuid())
  equipmentId    String
  equipment      Equipment         @relation(fields: [equipmentId], references: [id])
  commencement   WarrantyBasis
  durationMonths Int
  startDate      DateTime          @db.Date
  endDate        DateTime          @db.Date
  terms          String
  notes          String?
  files          StoredFile[]
  history        WarrantyHistory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([endDate])
}

model WarrantyHistory {
  id         String   @id @default(cuid())
  warrantyId String
  warranty   Warranty @relation(fields: [warrantyId], references: [id])
  snapshot   Json
  changedBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AmcContract {
  id                     String         @id @default(cuid())
  number                 String         @unique
  customerId             String
  customer               Customer       @relation(fields: [customerId], references: [id])
  startDate              DateTime       @db.Date
  endDate                DateTime       @db.Date
  amount                 Decimal        @db.Decimal(18, 2)
  serviceFrequencyMonths Int
  nextServiceDate        DateTime?      @db.Date
  responsibleName        String?
  status                 String         @default("ACTIVE")
  notes                  String?
  renewedFromId          String?
  equipment              AmcEquipment[]
  visits                 ServiceVisit[]
  files                  StoredFile[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([endDate, nextServiceDate])
}

model AmcEquipment {
  id          String      @id @default(cuid())
  amcId       String
  amc         AmcContract @relation(fields: [amcId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment   @relation(fields: [equipmentId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([amcId, equipmentId])
}

model ServiceVisit {
  id            String       @id @default(cuid())
  amcId         String
  amc           AmcContract  @relation(fields: [amcId], references: [id])
  employeeId    String?
  employee      User?        @relation(fields: [employeeId], references: [id])
  scheduledDate DateTime     @db.Date
  completedDate DateTime?    @db.Date
  status        String       @default("SCHEDULED")
  complaint     String?
  notes         String?
  files         StoredFile[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Invoice {
  id              String            @id @default(cuid())
  number          String            @unique
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])
  orderId         String
  order           PurchaseOrder     @relation(fields: [orderId], references: [id])
  invoiceDate     DateTime          @db.Date
  amount          Decimal           @db.Decimal(18, 2)
  taxAmount       Decimal           @db.Decimal(18, 2)
  total           Decimal           @db.Decimal(18, 2)
  paymentTermDays Int
  dueDate         DateTime          @db.Date
  notes           String?
  payments        Payment[]
  followUps       PaymentFollowUp[]
  files           StoredFile[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([dueDate])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amount      Decimal  @db.Decimal(18, 2)
  paymentDate DateTime @db.Date
  reference   String
  method      String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

model PaymentFollowUp {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id])
  employeeId  String?
  employee    User?     @relation(fields: [employeeId], references: [id])
  contactDate DateTime  @db.Date
  nextDate    DateTime? @db.Date
  notes       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([nextDate])
  @@index([invoiceId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  module      String
  recordId    String
  title       String
  priority    String
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, key])
  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  recordId  String?
  details   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module, createdAt])
}

model StoredFile {
  id                String             @id @default(cuid())
  name              String
  key               String             @unique
  mime              String
  size              Int
  sha256            String
  module            String
  recordId          String
  version           Int                @default(1)
  companyDocumentId String?
  companyDocument   CompanyDocument?   @relation(fields: [companyDocumentId], references: [id])
  tenderId          String?
  tender            Tender?            @relation(fields: [tenderId], references: [id])
  requirementId     String?
  requirement       TenderRequirement? @relation(fields: [requirementId], references: [id])
  orderId           String?
  order             PurchaseOrder?     @relation(fields: [orderId], references: [id])
  deliveryId        String?
  delivery          Delivery?          @relation(fields: [deliveryId], references: [id])
  warrantyId        String?
  warranty          Warranty?          @relation(fields: [warrantyId], references: [id])
  amcId             String?
  amc               AmcContract?       @relation(fields: [amcId], references: [id])
  invoiceId         String?
  invoice           Invoice?           @relation(fields: [invoiceId], references: [id])
  serviceVisitId    String?
  serviceVisit      ServiceVisit?      @relation(fields: [serviceVisitId], references: [id])
  rfqId String?
  rfq Rfq? @relation(fields: [rfqId], references: [id])
  quotationId String?
  quotation QuotationRevision? @relation(fields: [quotationId], references: [id])
  generated         GeneratedDocument?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([module, recordId])
}

model Task {
  id           String    @id @default(cuid())
  title        String
  notes        String?
  status       String    @default("OPEN")
  priority     String    @default("NORMAL")
  dueDate      DateTime? @db.Date
  completedAt  DateTime?
  createdById  String
  creator      User      @relation("CreatedTasks", fields: [createdById], references: [id])
  assignedToId String?
  assignee     User?     @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([assignedToId, status, dueDate])
  @@index([createdById])
}

model AppSettings {
  id                String   @id @default("main")
  aiEnabled         Boolean  @default(false)
  aiModel           String   @default("")
  aiDailyLimit      Int      @default(10)
  aiMaxOutputTokens Int      @default(1200)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AiRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("PENDING")
  purpose         String
  promptHash      String
  inputCharacters Int
  outputTokens    Int?
  costUsd         Decimal? @db.Decimal(16, 8)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
}


model TenderDecision {
  id String @id @default(cuid())
  tenderId String
  tender Tender @relation(fields: [tenderId], references: [id])
  decision String @default("PENDING_REVIEW")
  decisionBy String
  decisionAt DateTime @default(now())
  reason String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenderId, decisionAt])
}

model ManufacturerContact {
  id String @id @default(cuid())
  manufacturerId String
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])
  name String
  designation String?
  department String?
  email String?
  phone String?
  whatsapp String?
  region String?
  category String?
  preferredChannel String @default("EMAIL")
  active Boolean @default(true)
  notes String?
  rfqs Rfq[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([manufacturerId, active])
}

model Rfq {
  id String @id @default(cuid())
  number String @unique
  tenderId String?
  tender Tender? @relation(fields: [tenderId], references: [id])
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id])
  manufacturerId String
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])
  contactId String?
  contact ManufacturerContact? @relation(fields: [contactId], references: [id])
  productId String?
  product Product? @relation(fields: [productId], references: [id])
  productName String
  model String?
  quantity Int
  accessories String?
  warrantyRequirement String?
  deliveryLocation String?
  requiredDeliveryTime String?
  tenderDeadline DateTime?
  quoteRequiredBy DateTime?
  assignedToId String?
  assignee User? @relation(fields: [assignedToId], references: [id])
  status String @default("DRAFT")
  sentAt DateTime?
  receivedAt DateTime?
  notes String?
  historical Boolean @default(false)
  originalDate DateTime? @db.Date
  recordSource String @default("MANUAL")
  followUps RfqFollowUp[]
  quoteSeries QuoteSeries[]
  comparisons CommercialComparison[]
  files StoredFile[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, quoteRequiredBy])
  @@index([assignedToId, status])
}

model RfqFollowUp {
  id String @id @default(cuid())
  rfqId String
  rfq Rfq @relation(fields: [rfqId], references: [id])
  employeeId String?
  contactDate DateTime
  nextDate DateTime?
  notes String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([rfqId, nextDate])
}

model QuoteSeries {
  id String @id @default(cuid())
  number String
  manufacturerId String
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])
  rfqId String?
  rfq Rfq? @relation(fields: [rfqId], references: [id])
  tenderId String?
  tender Tender? @relation(fields: [tenderId], references: [id])
  productId String?
  product Product? @relation(fields: [productId], references: [id])
  revisions QuotationRevision[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([manufacturerId, number])
  @@index([tenderId])
}

model QuotationRevision {
  id String @id @default(cuid())
  seriesId String
  series QuoteSeries @relation(fields: [seriesId], references: [id])
  revision Int
  number String
  quotationDate DateTime @db.Date
  validityDate DateTime? @db.Date
  currency String @default("INR")
  productName String
  model String?
  quantity Int
  unitPrice Decimal @db.Decimal(18, 2)
  baseTotal Decimal @db.Decimal(18, 2)
  taxAmount Decimal @db.Decimal(18, 2)
  accessories String?
  accessoriesCost Decimal @db.Decimal(18, 2)
  freight Decimal @db.Decimal(18, 2)
  installation Decimal @db.Decimal(18, 2)
  warranty String?
  warrantyCost Decimal @db.Decimal(18, 2)
  extendedWarrantyCost Decimal @db.Decimal(18, 2)
  otherCosts Decimal @db.Decimal(18, 2)
  discount Decimal @db.Decimal(18, 2)
  total Decimal @db.Decimal(18, 2)
  finalManufacturerPrice Decimal? @db.Decimal(18, 2)
  leadTimeDays Int?
  paymentTerms String?
  isFinal Boolean @default(false)
  notes String?
  historical Boolean @default(false)
  originalDate DateTime? @db.Date
  recordSource String @default("MANUAL")
  comparisons CommercialComparison[]
  files StoredFile[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([seriesId, revision])
  @@index([validityDate])
}

model CommercialComparison {
  id String @id @default(cuid())
  name String
  tenderId String?
  tender Tender? @relation(fields: [tenderId], references: [id])
  rfqId String?
  rfq Rfq? @relation(fields: [rfqId], references: [id])
  quoteId String?
  quote QuotationRevision? @relation(fields: [quoteId], references: [id])
  currency String @default("INR")
  procurementCost Decimal @db.Decimal(18, 2)
  additionalCosts Decimal @db.Decimal(18, 2)
  sellingPrice Decimal @db.Decimal(18, 2)
  totalCost Decimal @db.Decimal(18, 2)
  contribution Decimal @db.Decimal(18, 2)
  marginPercent Decimal? @db.Decimal(12, 4)
  leadTimeDays Int?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenderId, rfqId])
}

model TenderResult {
  id String @id @default(cuid())
  tenderId String
  tender Tender @relation(fields: [tenderId], references: [id])
  outcome String
  resultDate DateTime @db.Date
  winner String?
  winningPrice Decimal? @db.Decimal(18, 2)
  competitorName String?
  reason String?
  notes String?
  recordedBy String
  historical Boolean @default(false)
  originalDate DateTime? @db.Date
  recordSource String @default("MANUAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenderId, resultDate])
}
